#include <winresrc.h>

1 ICON "app\\AppIcon.ico"

1 VERSIONINFO
FILEVERSION 2,1,0,0
PRODUCTVERSION 2,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "XiaoWang-SXAU-Lab"
            VALUE "FileDescription", "Folio - 学术主页与实验室网站编辑器"
            VALUE "FileVersion", "2.1.0"
            VALUE "InternalName", "Folio"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "Folio.exe"
            VALUE "ProductName", "Folio"
            VALUE "ProductVersion", "2.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
